{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence_pack.schema.json",
  "title": "LLM 근거 묶음 (input 1~4). input 3(propositions)은 FDS 인과그래프 근거 PR-n",
  "type": "object",
  "required": [
    "pack_version",
    "created_at",
    "request",
    "rule_version",
    "data_period",
    "warnings",
    "reading_rules",
    "integrated",
    "inputs",
    "evidence_index"
  ],
  "additionalProperties": false,
  "properties": {
    "pack_version": { "type": "string" },
    "created_at": { "type": "string" },
    "request": {
      "type": "object",
      "required": ["stock_code", "company_name", "buy_date", "eval_date"],
      "additionalProperties": false,
      "properties": {
        "stock_code": { "type": "string", "pattern": "^[0-9]{6}$" },
        "company_name": { "type": ["string", "null"] },
        "buy_date": { "type": "string" },
        "eval_date": { "type": "string" }
      }
    },
    "rule_version": { "type": "string" },
    "open_decisions": { "type": "array", "items": { "type": "string" } },
    "data_period": {
      "type": "object",
      "required": ["from", "to"],
      "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "reading_rules": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "integrated": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "hold" },
        "reason": { "type": "string" },
        "meaning": { "type": "string" }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["investor_opinion", "models", "propositions", "input4"],
      "additionalProperties": false,
      "properties": {
        "investor_opinion": {
          "type": "object",
          "required": ["text", "untrusted"],
          "properties": {
            "text": { "type": ["string", "null"] },
            "untrusted": { "const": true },
            "note": { "type": "string" }
          }
        },
        "models": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/model" }
        },
        "propositions": {
          "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/propositions" }]
        },
        "input4": { "type": ["object", "array", "null"] }
      }
    },
    "evidence_index": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "model"],
        "properties": {
          "id": { "$ref": "#/$defs/evidence_id" },
          "model": { "enum": ["fscore", "ohlson", "dupont", "gate", "graph"] }
        }
      }
    }
  },
  "$defs": {
    "model_name": { "enum": ["fscore", "ohlson", "dupont", "gate"] },
    "evidence_id": { "type": "string", "pattern": "^(FS|OH|DP|GT|PR)-[0-9]+$" },
    "model_evidence_id": { "type": "string", "pattern": "^(FS|OH|DP|GT)-[0-9]+$" },
    "hold": {
      "type": ["object", "null"],
      "required": ["codes", "meanings"],
      "properties": {
        "codes": { "type": "array", "items": { "type": "string" } },
        "meanings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["id", "statement", "values", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/model_evidence_id" },
        "statement": { "type": "string", "minLength": 1 },
        "values": { "type": "object" },
        "source": { "type": "object" }
      }
    },
    "graph_evidence": {
      "type": "object",
      "required": ["id", "statement", "values", "source"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^PR-[0-9]+$" },
        "statement": { "type": "string", "minLength": 1 },
        "values": { "type": "object" },
        "source": { "type": "object" }
      }
    },
    "graph_match": {
      "type": ["object", "null"],
      "required": ["node_id", "label", "score"],
      "properties": {
        "node_id": { "type": "string" },
        "label": { "type": "string" },
        "score": { "type": "number" }
      }
    },
    "propositions": {
      "type": "object",
      "required": ["model", "kind", "status", "graph_version", "reason", "raw_error", "card", "links", "evidence"],
      "additionalProperties": false,
      "properties": {
        "model": { "const": "graph" },
        "kind": { "const": "proposition" },
        "status": { "enum": ["computed", "no_links", "not_computed"] },
        "graph_version": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] },
        "raw_error": { "type": ["string", "null"] },
        "card": {
          "type": "object",
          "required": ["name", "kind", "scale", "measures", "how_to_read", "limits"]
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim", "cause", "cause_change", "effect", "effect_change", "status", "match",
                         "path", "edges", "checks", "net_sign", "direction_check", "model_links", "evidence_ids"],
            "additionalProperties": false,
            "properties": {
              "claim": { "type": "string" },
              "cause": { "type": "string" },
              "cause_change": { "enum": ["증가", "감소", "모름"] },
              "effect": { "type": "string" },
              "effect_change": { "enum": ["증가", "감소", "모름"] },
              "status": { "enum": ["found", "no_match", "no_path"] },
              "match": {
                "type": "object",
                "required": ["cause", "effect"],
                "properties": {
                  "cause": { "$ref": "#/$defs/graph_match" },
                  "effect": { "$ref": "#/$defs/graph_match" }
                }
              },
              "path": { "type": "array", "items": { "type": "object" } },
              "edges": { "type": "array", "items": { "type": "object" } },
              "checks": { "type": "array", "items": { "type": "object" } },
              "net_sign": { "enum": ["+", "-", null] },
              "direction_check": { "enum": ["same", "opposite", "not_compared", null] },
              "model_links": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["node_id", "label", "where", "model", "indicator", "match", "evidence"],
                  "properties": {
                    "where": { "enum": ["path", "check"] },
                    "model": { "enum": ["fscore", "ohlson", "dupont", "gate"] },
                    "match": { "enum": ["same", "part"] },
                    "evidence": { "type": "array", "items": { "$ref": "#/$defs/model_evidence_id" } }
                  }
                }
              },
              "evidence_ids": { "type": "array", "items": { "type": "string", "pattern": "^PR-[0-9]+$" } }
            }
          }
        },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/graph_evidence" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "computed" } } },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "status": { "enum": ["no_links", "not_computed"] } } },
          "then": { "properties": { "reason": { "type": "string" }, "evidence": { "maxItems": 0 } } }
        }
      ]
    },
    "model": {
      "type": "object",
      "required": ["model", "kind", "status", "hold", "card", "evidence"],
      "properties": {
        "model": { "$ref": "#/$defs/model_name" },
        "kind": { "enum": ["score", "gate"] },
        "status": { "enum": ["scored", "held", "not_computed"] },
        "risk_score": { "type": ["integer", "null"] },
        "risk_max": { "type": ["integer", "null"] },
        "scale_status": { "type": ["string", "null"] },
        "alarm_in_hold": { "type": ["boolean", "null"] },
        "alarm_on": { "type": ["boolean", "null"] },
        "settings": { "type": "object" },
        "hold": { "$ref": "#/$defs/hold" },
        "card": {
          "type": "object",
          "required": [
            "name",
            "kind",
            "scale",
            "measures",
            "how_to_read",
            "holds",
            "limits"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "gate" } } },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["risk_score"] },
                { "required": ["risk_max"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "const": "scored" },
              "kind": { "const": "score" }
            }
          },
          "then": {
            "properties": {
              "risk_score": { "type": "integer" },
              "hold": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "status": { "enum": ["held", "not_computed"] } }
          },
          "then": { "properties": { "hold": { "type": "object" } } }
        }
      ]
    }
  }
}
