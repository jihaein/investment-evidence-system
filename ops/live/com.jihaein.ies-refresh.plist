<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jihaein.ies-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jihaein/Developer/investment-evidence-system/ops/live/run_daily.sh</string>
  </array>
  <!-- Weekdays 19:30 and 22:30 KST (retry), plus 08:30 for overnight DART filings.
