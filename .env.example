# Worker and read-only API connections
SUPABASE_DB_URL=postgresql+psycopg://worker@localhost/investment_evidence
API_DB_URL=postgresql+psycopg://reader@localhost/investment_evidence
API_READ_TOKEN=

RAWDATA_DIR=/path/to/rawdata
MARKET_CALENDAR_CSV=/path/to/krx_sessions.csv
MARKET_COVERAGE_CSV=/path/to/stock_coverage.csv
MARKET_LISTING_EVENTS_CSV=
MARKET_START_SESSION=
MARKET_READY_AFTER_KST=19:00

KRX_ID=
KRX_PW=
OPENDART_API_KEY=

# Automatic DART conversion and worker cadence
DART_START_DATE=
DART_SNAPSHOT_DIR=/path/to/dart-snapshots
DART_POLL_MINUTES=60
MARKET_POLL_MINUTES=15

# The staging scheduler requires this separate value when run with --staging.
STAGING_DB_URL=

# Cloud file storage (ops/cloud/sync.py): Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CLOUD_BUCKET=ies-data
